{
  "name": "ai-digital-twin-evacuation",
  "version": "2.0.0",
  "description": "AI-Driven Fire Evacuation Digital Twin with Semantic Interoperability Middleware",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "app": "electron electron/main.cjs",
    "pack:win": "electron-builder --win --dir",
    "dist:win": "electron-builder --win",
    "test": "node tests/run_tests.mjs",
    "test:desktop": "node tests/test_mega_desktop_app_checker.mjs",
    "test:reset": "node tests/test_hard_reset.mjs",
    "test:fire": "node tests/test_fire_propagation.mjs",
    "test:routing": "node tests/test_deterministic_evacuation.mjs",
    "test:building-b": "node tests/test_building_b_generalization.mjs",
    "test:blocked": "node tests/test_blocked_exits_scenarios.mjs",
    "test:custom": "node tests/test_custom_building_adaptation.mjs",
    "test:security": "node tests/test_security.mjs",
    "test:stale": "node tests/test_stale_telemetry.mjs",
    "test:generation": "node tests/test_generation_id.mjs",
    "test:values": "node tests/test_value_ranges.mjs",
    "benchmark": "node benchmarks/run_experiments.mjs",
    "benchmark:all": "node benchmarks/run_all_benchmarks.mjs",
    "evaluate": "node benchmarks/evaluate_ml_model.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "digital-twin",
    "fire-evacuation",
    "semantic-interoperability",
    "gemini-ai",
    "iot",
    "building-management"
  ],
  "license": "MIT",
  "build": {
    "asar": false,
    "appId": "com.adithyan.digitaltwin",
    "productName": "AI Fire Evacuation Digital Twin",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "files": [
      "server.js",
      "index.html",
      "app.js",
      "package.json",
      "build/icon.ico",
      "build/icon.png",
      "electron/**/*",
      "data/**/*",
      "modules/**/*",
      "styles/**/*",
      "ui/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
